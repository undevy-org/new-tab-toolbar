{
  "manifest_version": 3,
  "name": "Quiet Tab",
  "version": "0.1.0",
  "description": "A personal favorites toolbar and local weather on the new tab page — nothing else.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "favicon"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://air-quality-api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  }
}
